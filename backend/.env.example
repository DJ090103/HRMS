NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1

DATABASE_URL=postgresql://user:password@host:5432/hrms?sslmode=require

JWT_ACCESS_SECRET=access_secret_here
JWT_REFRESH_SECRET=refresh_secret_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

REDIS_URL=redis://default:password@host:port

CORS_ORIGIN=https://your-frontend.vercel.app

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

RAZORPAY_KEY_ID=rzp_xxx
RAZORPAY_KEY_SECRET=your_secret
RAZORPAYX_WEBHOOK_SECRET=webhook_secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASS=password
EMAIL_FROM=no-reply@hrms.com
RESEND_API_KEY=
